<resources>
    <style name="Theme.SleepGuard" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#0B141B</item>
        <item name="android:navigationBarColor">#0B141B</item>
        <item name="android:windowBackground">#0B141B</item>
        <item name="android:colorAccent">#9CD7C7</item>
    </style>
    <style name="GoodNightClockDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#8EB9FF</item>
        <item name="android:colorBackground">#20232B</item>
        <item name="android:dialogCornerRadius">24dp</item>
        <item name="android:timePickerStyle">@style/GoodNightClockFace</item>
    </style>

    <style name="GoodNightClockFace" parent="@android:style/Widget.Material.TimePicker">
        <item name="android:timePickerMode">clock</item>
        <item name="android:headerBackground">@android:color/transparent</item>
        <item name="android:headerTextColor">@color/clock_header</item>
        <item name="android:numbersBackgroundColor">#292D37</item>
        <item name="android:numbersSelectorColor">#4778EF</item>
    </style>
</resources>
